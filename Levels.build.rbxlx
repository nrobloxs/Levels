      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">LevelService</string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">LevelServiceClient</string>
              <string name="Source"><![CDATA[-- LevelServiceClient
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Networker = require(ReplicatedStorage.Packages.Networker)
local LevelServiceUtils = require(script.Parent.LevelServiceUtils)
local Data = require(ReplicatedStorage.Shared.Data).client
local Player = Players.LocalPlayer

local LevelServiceClient = {}

function LevelServiceClient.LevelUpdated(self: LevelServiceClient, player)
	if player ~= Player then
		return
	end

	self:RefreshUI()
end

function LevelServiceClient.init(self: LevelServiceClient)
	self.Tags = {
		MainScreen = "LevelScreen",
		ShowLevel_Label = "LevelLabel",
		ShowXP_MaxBar = "XP_MaxBar",
		ShowXP_CurrBar = "XP_CurrBar",
		ShowXP_Label = "XPLabel",
		ShowLevelNotice_Label = "LevelNoticeLabel",
	}
	self._LevelNoticeToken = 0

	self.Networker = Networker.client.new("LevelService", self)

	local PlayerGui: PlayerGui = Player:WaitForChild("PlayerGui")
	local LevelScreen: ScreenGui = LevelServiceUtils.GetInstanceWithTag(PlayerGui, self.Tags.MainScreen)
	if not LevelScreen then
		warn("[LevelServiceClient] LevelScreen not found.")
		return
	end

	self.LevelLabel = LevelServiceUtils.GetInstanceWithTag(LevelScreen, self.Tags.ShowLevel_Label)
	self.LevelNoticeLabel = LevelServiceUtils.GetInstanceWithTag(LevelScreen, self.Tags.ShowLevelNotice_Label)
	self.XPMaxBar = LevelServiceUtils.GetInstanceWithTag(LevelScreen, self.Tags.ShowXP_MaxBar)
	self.XPCurrBar = LevelServiceUtils.GetInstanceWithTag(LevelScreen, self.Tags.ShowXP_CurrBar)
	self.XPLabel = LevelServiceUtils.GetInstanceWithTag(LevelScreen, self.Tags.ShowXP_Label)

	if self.LevelNoticeLabel then
		self.LevelNoticeLabel.Visible = false
	end

	self:RefreshUI()

	Data.Level.Changed(function(lvl)
		LevelServiceUtils.PlayLevelUp_Vfx(Player.Character)
		LevelServiceUtils.PlayLevelUp_Sound(Player.Character)

		if self.LevelNoticeLabel then
			self._LevelNoticeToken += 1
			local token = self._LevelNoticeToken
			self.LevelNoticeLabel.Visible = true
			self.LevelNoticeLabel.Text = "YOU LEVELED UP! NEW LEVEL: " .. tostring(lvl)
			task.delay(1, function()
				if self.LevelNoticeLabel and self._LevelNoticeToken == token then
					self.LevelNoticeLabel.Visible = false
				end
			end)
		end

		self:RefreshUI()
	end)

	Data.XP.Changed(function()
		self:RefreshUI()
	end)
end

function LevelServiceClient.RefreshUI(self: LevelServiceClient)
	if not self.LevelLabel or not self.XPMaxBar or not self.XPCurrBar then
		return
	end

	local level = Data.Level()
	local currentXP = Data.XP()
	local requiredXP = LevelServiceUtils:CalculateXP(level) or 0

	self.LevelLabel.Text = "Level " .. tostring(level)
	LevelServiceUtils:UpdateXP_UI(self.XPMaxBar, self.XPCurrBar, self.XPLabel, currentXP, requiredXP)
end

type LevelServiceClient = typeof(LevelServiceClient) & {
	Tags: {
		MainScreen: string,
		ShowLevel_Label: string,
		ShowXP_MaxBar: string,
		ShowXP_CurrBar: string,
		ShowXP_Label: string,
		ShowLevelNotice_Label: string,
	},
	LevelLabel: TextLabel?,
	LevelNoticeLabel: TextLabel?,
	XPMaxBar: GuiObject?,
	XPCurrBar: GuiObject?,
	XPLabel: TextLabel?,
	_LevelNoticeToken: number,
	Networker: Networker.Client,
}

return LevelServiceClient :: LevelServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">LevelServiceUtils</string>
              <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LevelServiceUtils = {}

function LevelServiceUtils.init(self: LevelServiceUtils)
	self.XP_Config = {
		BASE_XP = 100,
		GROWTH_RATE = 1.15,
		LINEAR_BONUS = 50,
	}

	self.BarTweenInfo = {
		Duration = 0.3,
		EaseStyle = Enum.EasingStyle.Sine,
		EaseDirection = Enum.EasingDirection.InOut,
	}
end

function LevelServiceUtils.CalculateXP(self: LevelServiceUtils, Level: number): number?
	if typeof(Level) ~= "number" or Level < 1 then
		return nil
	end

	local exponential = self.XP_Config.BASE_XP * (self.XP_Config.GROWTH_RATE ^ (Level - 1))
	local linear = self.XP_Config.LINEAR_BONUS * (Level - 1)
	return math.floor(exponential + linear)
end

function LevelServiceUtils.IsGreaterThanMaxLvl(MaxLvl: number, Level: number): boolean
	if typeof(MaxLvl) ~= "number" or typeof(Level) ~= "number" then
		return false
	end

	if MaxLvl <= 0 then
		return false
	end

	return Level > MaxLvl
end

function LevelServiceUtils.GetInstanceWithTag(Container: Instance, tag: string)
	if not Container or typeof(tag) ~= "string" or tag == "" then
		return nil
	end

	if CollectionService:HasTag(Container, tag) then
		return Container
	end

	for _, instance in Container:GetDescendants() do
		if CollectionService:HasTag(instance, tag) then
			return instance
		end
	end

	return nil
end

function LevelServiceUtils.PlayLevelUp_Vfx(Character: Model)
	if not Character or not Character:FindFirstChild("HumanoidRootPart") then
		return
	end

	local AssetsFolder = ReplicatedStorage:FindFirstChild("Assets")
	if not AssetsFolder then
		return
	end

	local VfxFolder = AssetsFolder:FindFirstChild("Vfx")
	if not VfxFolder then
		return
	end

	local LevelFolder = VfxFolder:FindFirstChild("Level")
	if not LevelFolder then
		return
	end

	task.spawn(function()
		for _, vfx in LevelFolder:GetDescendants() do
			if vfx:IsA("ParticleEmitter") then
				local clonedVfx = vfx:Clone()
				clonedVfx.Parent = Character.HumanoidRootPart
				clonedVfx:Emit(clonedVfx:GetAttribute("EmitCount") or 25)
				Debris:AddItem(clonedVfx, 2)
			end
		end
	end)
end

function LevelServiceUtils.PlayLevelUp_Sound(Character: Model)
	if not Character or not Character:FindFirstChild("HumanoidRootPart") then
		return
	end

	local AssetsFolder = ReplicatedStorage:FindFirstChild("Assets")
	if not AssetsFolder then
		return
	end

	local AudioFolder = AssetsFolder:FindFirstChild("Audio")
	if not AudioFolder then
		return
	end

	local LevelFolder = AudioFolder:FindFirstChild("Level")
	if not LevelFolder then
		return
	end

	local LevelUpSound = LevelFolder:FindFirstChild("LevelUp") :: Sound
	if not LevelUpSound then
		return
	end

	local ClonedLevelUpSound = LevelUpSound:Clone()
	ClonedLevelUpSound.Parent = Character.HumanoidRootPart
	ClonedLevelUpSound:Play()
	Debris:AddItem(ClonedLevelUpSound, 3)
end

function LevelServiceUtils.UpdateXP_UI(
	self: LevelServiceUtils,
	MaxBar: GuiObject,
	CurrentBar: GuiObject,
	XPLabel: TextLabel?,
	XP: number,
	MaxXP: number?
)
	if not MaxBar or not CurrentBar then
		return
	end

	local safeMaxXP = MaxXP or 0
	local ratio = (safeMaxXP > 0) and math.clamp(XP / safeMaxXP, 0, 1) or 0
	local tweenInfo = TweenInfo.new(
		self.BarTweenInfo.Duration,
		self.BarTweenInfo.EaseStyle,
		self.BarTweenInfo.EaseDirection,
		0,
		false,
		0
	)

	TweenService:Create(CurrentBar, tweenInfo, {
		Size = UDim2.fromScale(ratio, 1),
	}):Play()

	if XPLabel then
		XPLabel.Text = "XP " .. tostring(XP) .. "/" .. tostring(safeMaxXP)
	end
end

type LevelServiceUtils = typeof(LevelServiceUtils) & {
	XP_Config: {
		BASE_XP: number,
		GROWTH_RATE: number,
		LINEAR_BONUS: number,
	},

	BarTweenInfo: {
		Duration: number,
		EaseStyle: Enum.EasingStyle,
		EaseDirection: Enum.EasingDirection,
	},
}

return LevelServiceUtils :: LevelServiceUtils
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="32">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="33">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Data = require(ReplicatedStorage.Shared.Data).server
local LevelServiceUtils = require(ReplicatedStorage.Shared.Services.LevelService.LevelServiceUtils)
local LevelServiceServer = require(script.Services.LevelService.LevelServiceServer)

LevelServiceUtils:init()
LevelServiceServer:init()

Players.PlayerAdded:Connect(function(player: Player)
	Data.Service:waitForData(player)
	warn("[SERVER] DATA LOADED FOR PLAYER: ", player.Name)

	for _i = 1, 100 do
		LevelServiceServer:IncrementLevel(player, 1)
		task.wait(1)
	end
end)
]]></string>
      </Properties>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="Folder" referent="35">
          <Properties>
            <string name="Name">LevelService</string>
          </Properties>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">LevelServiceServer</string>
              <string name="Source"><![CDATA[-- LevelServiceServer
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Networker = require(ReplicatedStorage.Packages.Networker)
local LevelServiceUtils = require(ReplicatedStorage.Shared.Services.LevelService.LevelServiceUtils)
local Data = require(ReplicatedStorage.Shared.Data).server

local LevelServiceServer = {}

function LevelServiceServer.init(self: LevelServiceServer)
	self.Level_Config = {
		Max_Level = 2500,
	}

	self.Networker = Networker.server.new("LevelService", self, {})

	Players.PlayerAdded:Connect(function(player: Player)
		Data.Service:waitForData(player)
		Data[player].Level.Changed(function(_)
			self.Networker:fireAll("LevelUpdated", player)
		end)
	end)
end

function LevelServiceServer.SetLevel(self: LevelServiceServer, player: Player, Level: number)
	if not player or not Data[player] or typeof(Level) ~= "number" then
		return
	end

	if Level < 1 then
		return
	end

	if LevelServiceUtils.IsGreaterThanMaxLvl(self.Level_Config.Max_Level, Level) then
		return
	end

	Data[player].Level(Level)
end

function LevelServiceServer.IncrementLevel(self: LevelServiceServer, player: Player, Increment: number)
	if not player or not Data[player] or typeof(Increment) ~= "number" then
		return
	end

	if Increment <= 0 then
		return
	end

	local nextLevel = Data[player].Level() + Increment
	if LevelServiceUtils.IsGreaterThanMaxLvl(self.Level_Config.Max_Level, nextLevel) then
		return
	end

	Data[player].Level(function(currentLevel)
		return currentLevel + Increment
	end)
end

function LevelServiceServer.DecrementLevel(self: LevelServiceServer, player: Player, Decrement: number)
	if not player or not Data[player] or typeof(Decrement) ~= "number" then
		return
	end

	if Decrement <= 0 then
		return
	end

	local targetLevel = Data[player].Level() - Decrement
	if targetLevel < 1 then
		return
	end

	Data[player].Level(function(currentLevel)
		return currentLevel - Decrement
	end)
end

function LevelServiceServer.GiveXP(self: LevelServiceServer, player: Player, Amount: number)
	if not player or not Data[player] or typeof(Amount) ~= "number" then
		return
	end

	if Amount <= 0 then
		return
	end

	local startingLevel = Data[player].Level()
	local levelsGained = 0
	local newXP = Data[player].XP() + Amount
	local currentLevel = startingLevel

	while not LevelServiceUtils.IsGreaterThanMaxLvl(self.Level_Config.Max_Level, currentLevel + 1) do
		local requiredXP = LevelServiceUtils:CalculateXP(currentLevel)
		if not requiredXP or newXP < requiredXP then
			break
		end

		newXP -= requiredXP
		currentLevel += 1
		levelsGained += 1
	end

	if LevelServiceUtils.IsGreaterThanMaxLvl(self.Level_Config.Max_Level, currentLevel + 1) then
		local maxLevelXP = LevelServiceUtils:CalculateXP(currentLevel) or 0
		newXP = math.min(newXP, maxLevelXP)
	end

	Data[player].XP(newXP)

	if levelsGained > 0 then
		self:IncrementLevel(player, levelsGained)
	end
end

function LevelServiceServer.RemoveXP(self: LevelServiceServer, player: Player, Amount: number)
	if not player or not Data[player] or typeof(Amount) ~= "number" then
		return
	end

	if Amount <= 0 then
		return
	end

	local currentLevel = Data[player].Level()
	local levelsLost = 0
	local newXP = Data[player].XP() - Amount

	while newXP < 0 and currentLevel > 1 do
		currentLevel -= 1
		levelsLost += 1
		newXP += LevelServiceUtils:CalculateXP(currentLevel) or 0
	end

	Data[player].XP(math.max(0, newXP))

	if levelsLost > 0 then
		self:DecrementLevel(player, levelsLost)
	end
end

type LevelServiceServer = typeof(LevelServiceServer) & {
	Level_Config: {
		Max_Level: number,
	},
	Networker: Networker.Server,
}

return LevelServiceServer :: LevelServiceServer
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
