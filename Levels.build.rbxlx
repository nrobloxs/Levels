              <string name="Name">dataservicetyped</string>
              <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local DataServiceClient = require(script.DataServiceClient)
local DataServiceServer = require(script.DataServiceServer)
local DataServiceUtils = require(script.DataServiceUtils)
local Value = require(script.Value)

export type Client<T> = DataServiceClient.DataServiceClient<T>
export type Server<T> = DataServiceServer.DataServiceServer<T>
export type DataOptions<T> = DataServiceUtils.DataOptions<T>
export type Value<T> = Value.Value<T>
export type PublicDataServiceServer<T> = DataServiceServer.Public<T>
export type ServerPlayerData<T> = { [Player]: Value<T> } & {
	Service: PublicDataServiceServer<T>,
}

return function<T>(options: DataOptions<T>)
	return {
		client = (if RunService:IsClient() then DataServiceClient:init(options.template) else {}) :: Value<T>,
		server = (if RunService:IsServer() then DataServiceServer:init(options) else {}) :: ServerPlayerData<T>,
	}
end
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="9">
              <Properties>
                <string name="Name">DataServiceClient</string>
                <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local Packages = script.Parent.Parent
local Signal = require(Packages.Signal)
local Networker = require(Packages.Networker)
local Value = require(script.Parent.Value)

if RunService:IsServer() then
	return {} :: any
end

local DataServiceClient = {
	hasLoaded = false,
	loadedSignal = Signal.new(),
}

function DataServiceClient.init<T>(self: DataServiceClient<T>, template: T)
	self.networker = Networker.client.new("DataService", self)

	if not RunService:IsRunning() then
		self:load(template)
	end

	if self.hasLoaded then
		return self.data
	end

	self.loadedSignal:Wait()

	return self.data
end

function DataServiceClient.load<T>(self: DataServiceClient<T>, data: T)
	self.data = Value.new(data)
	self.hasLoaded = true
	self.loadedSignal:Fire()
end

function DataServiceClient.get<T>(self: DataServiceClient<T>, path: { string }): Value.Value<any>
	if not self.hasLoaded then
		self.loadedSignal:Wait()
	end

	local current = self.data
	for i = #path, 2, -1 do
		local key = path[i]
		current = (current :: any)[key]
	end

	return current[path[1]]
end

function DataServiceClient.set<T>(self: DataServiceClient<T>, path: { string }, value: any?)
	self:get(path)(value)
end

function DataServiceClient.insert<T>(self: DataServiceClient<T>, path: { string }, item: any, pos: number?)
	self:get(path).Insert(item, pos)
end

function DataServiceClient.remove<T>(self: DataServiceClient<T>, path: { string }, pos: number?)
	self:get(path).Remove(pos)
end

export type DataServiceClient<T> = typeof(DataServiceClient) & {
	hasLoaded: boolean,
	loadedSignal: Signal.Signal<>,
	networker: Networker.Client,
	data: Value.Value<T>,
}

return DataServiceClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="10">
              <Properties>
                <string name="Name">DataServiceServer</string>
                <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

if RunService:IsClient() then
	return {} :: any
end

local Packages = script.Parent.Parent
local Value = require(script.Parent.Value)
local DataServiceUtils = require(script.Parent.DataServiceUtils)
local Signal = require(Packages.Signal)
local Networker = require(Packages.Networker)
local ProfileStore = if RunService:IsServer() then require(Packages.ProfileStore) else nil :: any

local DATA_PREFIX = "PLAYER_"
local DEFAULT_PROFILE_STORE_INDEX = "Default"

--[=[
	@type DataTemplate { [string]: any }
	@within DataServiceServer
	
	Defines the structure of player data used by the DataServiceServer.

	```lua
	local datatemplate = {
		currency = 0,
		inventory = {
			apples = 5,
			oranges = 10,
		},
		settings = {
			music = true,
		},
		items = {} :: { [string]: ItemData },
		array = {} :: { number },
	}
	```

	
	:::note
	Player data automatically reconciles the template on join if new keys are added.
	:::
	:::warning
	Follow JSON rules for all data. (e.g., no Vector3, CFrame, etc.)
	:::
]=]
type DataTemplate = { [string | number]: any }

--[=[
	@interface DataOptions
	@within DataServiceServer
	.template DataTemplate -- Template dictionary for player data.
	.profileStoreIndex string -- Index for the ProfileStore.
	.useMock boolean? -- Use Mock data for testing.
	.viewedUserId number? -- User ID to view data for. Use to view a specific player's data without saving.
	.overridenUserId number? -- User ID to override for the profile. Use to play on another player's save.
	.dontSave boolean? -- Prevent saving the profile. Use for testing without saving.
	.resetData boolean? -- Reset the data on player join. Use to wipe data for testing.
	
	```lua
	local options = {
		template = require(path.to.datatemplate),
		profileStoreIndex = "Public",
	}
	```

	Provides options for initializing the DataServiceServer.
]=]
type DataOptions<T> = DataServiceUtils.DataOptions<T>
type MessageData = { key: string, data: { any } }

local DataServiceServer = {
	_profiles = {} :: any,
	_waitSignals = {} :: { [Player]: Signal.Signal<any> },
	_removalFunctions = {} :: { (player: Player, data: any) -> () },
	_globalCallbacks = {} :: { [string]: (player: Player, { any }) -> boolean? },
	_globalCallbackAdded = Signal.new() :: Signal.Signal<string>,
	data = {} :: { [Player]: Value.Value<any> },
}

--[=[
	@class DataServiceServer
	The server-side service for managing player data.
]=]
function DataServiceServer:init<T>(options: DataOptions<T>)
	assert(RunService:IsServer(), "DataServiceServer can only be used on the server.")
	assert(not self.playerStore, "DataServiceServer has already been initialized.")
	Value.shouldRecordPath = true
	self.options = options
	self.networker = Networker.server.new("DataService", self, {})
	self.playerStore = ProfileStore.New(options.profileStoreIndex or DEFAULT_PROFILE_STORE_INDEX, options.template)

	for _, player: Player in Players:GetPlayers() do
		task.spawn(function()
			self:_playerAdded(player)
		end)
	end

	Players.PlayerAdded:Connect(function(player: Player)
		self:_playerAdded(player)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		self:_playerRemoving(player)
	end)

	self.data.Service = self
	return self.data
end

local function storeCancel(player: Player)
	return {
		Cancel = function()
			return player.Parent ~= Players
		end,
	}
end

--[=[
	@method resetData
	@within DataServiceServer
	@param player Player

	Resets the data for the specified player by removing their profile from the store.
	The player is then kicked from the game with a message to rejoin.

	```lua
	Data.Service:resetData(player)
	```
]=]
function DataServiceServer.resetData(self: DataServiceServer<any>, player: Player): ()
	local index = self:_getProfileKey(player.UserId)
	self:_playerRemoving(player)
	self.playerStore:RemoveAsync(index)
	player:Kick("Your data has been reset. Please rejoin.")
end

function DataServiceServer:_playerAdded(player: Player)
	local userId = self.options.overridenUserId or self.options.viewedUserId or player.UserId
	local index = self:_getProfileKey(userId)

	if self.options.resetData and not self.options.viewedUserId then
		self.playerStore:RemoveAsync(index)
	end

	local profile = if self.options.useMock
		then self.playerStore.Mock:StartSessionAsync(index, storeCancel(player))
		elseif self.options.viewedUserId or self.options.dontSave then self.playerStore:GetAsync(index)
		else self.playerStore:StartSessionAsync(index, storeCancel(player))

	profile:AddUserId(userId)
	profile:Reconcile()
	profile.OnSessionEnd:Connect(function()
		self._profiles[player] = nil
		player:Kick(`Profile session end - Please rejoin`)
	end)

	if not player:IsDescendantOf(Players) then
		player:Kick(`Profile load fail - Please rejoin`)
		return
	end

	self._profiles[player] = profile
	self:_initPlayer(player, profile.Data)

	if not player:IsDescendantOf(Players) then
		player:Kick(`Profile load fail - Please rejoin`)
		return
	end

	profile:MessageHandler(function(messageData: MessageData, processed: () -> ())
		local cb = self._globalCallbacks[messageData.key]
		if cb then
			if (cb :: any)(player, messageData.data) ~= false then
				processed()
			end
			return
		end

		local waitConnection: any
		waitConnection = self._globalCallbackAdded:Connect(function(key: string)
			if key ~= messageData.key then
				return
			end

			local newCb = self._globalCallbacks[messageData.key]
			if (newCb :: any)(player, messageData.data) ~= false then
				processed()
			end

			waitConnection:Disconnect()
		end)
	end)
end

--[=[
	@method sendGlobalMessage
	@within DataServiceServer
	@param key string
	@param userId number | string
	@param data { any }
	@return boolean

	Sends a global message to the specified user's profile.
	Returns true if the message was sent successfully, false otherwise.

	```lua
	Data.Service:sendGlobalMessage("SendGift", userId, { currency = 100, from = "Friend" })
	```
]=]
function DataServiceServer.sendGlobalMessage(
	self: DataServiceServer<any>,
	key: string,
	userId: number | string,
	data: { any }
): boolean
	local messageData: MessageData = { key = key, data = data }
	return self.playerStore:MessageAsync(self:_getProfileKey(userId), messageData)
end

--[=[
	@method addGlobalCallback
	@within DataServiceServer
	@param key string
	@param cb (player: Player, data: { any }) -> boolean?

	Adds a global callback function for handling messages with the specified key.
	The callback receives the player and data as parameters.
	If the callback returns false, the message is not processed further.

	```lua
	Data.Service:addGlobalCallback("SendGift", function(player: Player, data: { any }): boolean?
		print("Received gift for", player.Name, "with data:", data)
		-- Process the gift here
	end)
	```
]=]
function DataServiceServer.addGlobalCallback(
	self: DataServiceServer<any>,
	key: string,
	cb: (player: Player, { any }) -> boolean?
): ()
	assert(self._globalCallbacks[key] == nil, "Global callback already exists for key: " .. key)
	self._globalCallbacks[key] = cb
	self._globalCallbackAdded:Fire(key)
end

function DataServiceServer._getProfileKey(self: DataServiceServer<any>, userId: number | string): string
	return self:_getDataPrefix() .. tostring(userId)
end

function DataServiceServer._getDataPrefix(self: DataServiceServer<any>): string
	return self.options.profileStoreDataPrefix or DATA_PREFIX
end

--[=[
	@method onPlayerInit
	@within DataServiceServer
	@tag Override
	@param player Player
	@param data DataTemplate

	Overridable method called when a player initializes their data.
	You can use this method to set initial values or perform actions when a player joins.

	```lua
	function Data.Service:onPlayerInit(player: Player, data: DataTemplate): ()
		print(player.Name .. " has initialized with data:", data)
		data.sessionJoinTime = os.time() -- We can directly modify data since no connections exist yet.
	end
	```

	:::note
	`onPlayerInit` is called after a player's data has loaded but before it is sent to the client or is available to the server.
	:::
]=]
function DataServiceServer.onPlayerInit<T>(_self: DataServiceServer<T>, _player: Player, _data: T) end

function DataServiceServer._initPlayer<T>(self: DataServiceServer<any>, player: Player, data: T): ()
	self:onPlayerInit(player, data)
	self.networker:fire(player, "load", data)

	self.data[player] = Value.new(data, nil, nil, function(replicateType: string, path: { string }, ...)
		self.networker:fire(player, replicateType, path, ...)
	end)

	local waitSignal = self._waitSignals[player]
	if waitSignal then
		waitSignal:Fire()
		waitSignal:Destroy()
		self._waitSignals[player] = nil
	end
end

function DataServiceServer._playerRemoving(self: DataServiceServer<any>, player: Player): ()
	local profile = self._profiles[player] :: any
	if not profile then
		return
	end

	for _, fn in self._removalFunctions do
		local success, err: any? = pcall(fn, player, profile.Data)
		if not success then
			warn(err or "Error in removal function for " .. player.Name)
		end
	end

	profile:EndSession()
	self._profiles[player] = nil

	local waitSignal = self._waitSignals[player]
	if waitSignal then
		waitSignal:Destroy()
		self._waitSignals[player] = nil
	end

	self.data[player] = nil
end

--[=[
	@method addPlayerRemovingCallback
	@within DataServiceServer
	@param fn (player: Player, data: any) -> ()

	Add any number of functions to be called when a player is removed.
	Used to perform cleanup or save data before the player leaves.

	```lua
	Data.Service:addPlayerRemovingCallback(function(player: Player, data: any): ()
		print(player.Name .. " is leaving with data:", data)
		-- Perform any cleanup or save operations here
	end)
	```

	```lua
	local disconnect = Data.Service:addPlayerRemovingCallback(function(player: Player, data: any): ()
		data.currency = 0
	end)

	-- Later, you can disconnect this function if needed
	disconnect()
	```
]=]
function DataServiceServer.addPlayerRemovingCallback(
	self: DataServiceServer<any>,
	fn: (player: Player, data: any) -> ()
): () -> ()
	table.insert(self._removalFunctions, fn)
	return function()
		local index = table.find(self._removalFunctions, fn)
		if index then
			table.remove(self._removalFunctions, index)
		end
	end
end

--[=[
	@method asyncGetProfile
	@within DataServiceServer
	@param userId number | string
	@return Profile?

	Asynchronously retrieves the profile for the given user ID using internal ProfileStore.
]=]
function DataServiceServer.asyncGetProfile(self: DataServiceServer<any>, userId: number | string): any?
	return self.playerStore:GetAsync(self:_getProfileKey(userId))
end

--[=[
	@method getProfile
	@within DataServiceServer
	@param player Player
	@return Profile

	Retrieves the profile for the given player.
]=]
function DataServiceServer.getProfile(self: DataServiceServer<any>, player: Player): any
	return self._profiles[player]
end

--[=[
	@method waitForData
	@within DataServiceServer
	@yields
	@param player Player
	@return Data

	Waits for the player's data to be initialized and returns it.
	If the data is already available, it returns immediately.
]=]
function DataServiceServer.waitForData(self: DataServiceServer<any>, player: Player): any
	local data = self.data[player]
	if data then
		return data
	end

	local waitSignal = self._waitSignals[player]
	if not waitSignal then
		waitSignal = Signal.new()
		self._waitSignals[player] = waitSignal
	end

	waitSignal:Wait()
	return self.data[player]
end

export type DataServiceServer<T> = typeof(DataServiceServer) & {
	networker: Networker.Server,
	data: { [Player]: Value.Value<any> },
	options: DataOptions<T>,
	playerStore: any,
}

export type Public<T> = {
	waitForData: (self: any, player: Player) -> (),
	onPlayerInit: (self: any, player: Player, data: T) -> (),
	getProfile: (self: any, player: Player) -> any,
	asyncGetProfile: (self: any, userId: number | string) -> any,
	resetData: (self: any, player: Player) -> (),
	addPlayerRemovingCallback: (self: any, fn: (player: Player, data: any) -> ()) -> () -> (),
	addGlobalCallback: (self: any, key: string, cb: (player: Player, { any }) -> boolean?) -> (),
	sendGlobalMessage: (self: any, key: string, userId: number | string, data: { any }) -> (),
}

return DataServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="11">
              <Properties>
                <string name="Name">DataServiceUtils</string>
                <string name="Source"><![CDATA[export type DataOptions<T> = {
	template: T,
	useMock: boolean?,
	viewedUserId: number?,
	overridenUserId: number?,
	dontSave: boolean?,
	resetData: boolean?,
	profileStoreIndex: string?,
	profileStoreDataPrefix: string?,
}

return nil
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="12">
              <Properties>
                <string name="Name">Value</string>
                <string name="Source"><![CDATA[local PARENT_KEY = "___P"
local KEY_KEY = "___K"
local CHILDREN_KEY = "___C"
local CONTAINER_KEY = "___X"
local REPLICATOR_KEY = "___R"
local CHANGED_KEY = "_ChangedCbs"
local ARRAY_INSERTED_KEY = "_OnInsertCbs"
local ARRAY_REMOVED_KEY = "_OnRemoveCbs"
local KEY_ADDED_KEY = "_OnKeyAddedCbs"
local KEY_REMOVED_KEY = "_OnKeyRemovedCbs"
local meta = {}
local Value = { shouldRecordPath = false }

local function adoptChildren(value: Value<any>)
	local raw = value()
	if type(raw) ~= "table" then
		return
	end

	local children = rawget(value, CHILDREN_KEY) :: { [any]: any }
	if not children then
		children = {}
		rawset(value, CHILDREN_KEY, children)
	end

	for key, _ in raw :: any do
		local childValue = children[key]
		if not childValue then
			childValue = Value.new(raw, key, value)
			children[key] = childValue
		end
	end

	for key, childValue in children do
		rawset(childValue, CONTAINER_KEY, raw)
		if raw[key] ~= nil then
			continue
		end

		-- Maybe change to hasCallbackDeep in future
		local hasChangedCallback = rawget(childValue, CHANGED_KEY) ~= nil
		if not hasChangedCallback then
			children[key] = nil
		end
	end
end

local function sendChangedSignalToChildren(value: Value<any>, initial: boolean?)
	if not initial then
		local changedCbs = rawget(value, CHANGED_KEY) :: any
		if changedCbs then
			local raw = value()
			for _, cb in changedCbs do
				task.spawn(cb, raw)
			end
		end
	end

	local childrenValues = rawget(value, CHILDREN_KEY)
	if not childrenValues then
		return
	end

	for _, childValue in childrenValues do
		sendChangedSignalToChildren(childValue)
	end
end

local function createCallbackFn(fnKey: string)
	return function(value: Value<any>)
		return function<T>(cb: (T) -> () -> ())
			local changedCbs = rawget(value, fnKey) :: any
			if not changedCbs then
				changedCbs = {}
				rawset(value, fnKey, changedCbs)
			end

			table.insert(changedCbs, cb)
			return function()
				local updatedCbs = rawget(value, fnKey) :: any
				if not updatedCbs then
					return
				end

				local cbIndex = table.find(updatedCbs, cb)
				if not cbIndex then
					return
				end

				table.remove(updatedCbs, cbIndex)
				if #updatedCbs == 0 then
					rawset(value, fnKey, nil)
				end
			end
		end
	end
end

local Changed = createCallbackFn(CHANGED_KEY)
local OnInsert = createCallbackFn(ARRAY_INSERTED_KEY)
local OnRemove = createCallbackFn(ARRAY_REMOVED_KEY)
local OnKeyAdded = createCallbackFn(KEY_ADDED_KEY)
local OnKeyRemoved = createCallbackFn(KEY_REMOVED_KEY)

local function fireChangeAndReplicate<T>(
	value: Value<T>,
	prevRawValue: T?,
	replicateType: string?,
	forcedReplication: boolean?,
	...
)
	local shouldReplicate = forcedReplication ~= false
	local path = if Value.shouldRecordPath and shouldReplicate then {} else nil
	local currentValue: any = value
	local prevKey = nil
	local replicaterFn

	local immediateParentValue = rawget(value, PARENT_KEY) :: any
	if immediateParentValue ~= nil and replicateType == "set" then
		local key = rawget(value, KEY_KEY)
		local rawValue = value()

		if prevRawValue == nil and rawValue ~= nil then
			local keyAddedCbs = rawget(immediateParentValue, KEY_ADDED_KEY) :: any
			if keyAddedCbs then
				for _, cb in keyAddedCbs do
					task.spawn(cb, key, rawValue)
				end
			end
		elseif prevRawValue ~= nil and rawValue == nil then
			local keyRemovedCbs = rawget(immediateParentValue, KEY_REMOVED_KEY) :: any
			if keyRemovedCbs then
				for _, cb in keyRemovedCbs do
					task.spawn(cb, key, prevRawValue)
				end
			end
		end
	end

	repeat
		local pathKey = rawget(currentValue, KEY_KEY)
		if path and pathKey ~= nil then
			table.insert(path, pathKey)
		end

		if not replicaterFn then
			replicaterFn = rawget(currentValue, REPLICATOR_KEY)
		end

		local changedCbs = rawget(currentValue, CHANGED_KEY) :: any
		if changedCbs then
			local v = currentValue()
			for _, cb in changedCbs do
				task.spawn(cb, v, prevRawValue, prevKey)
			end
		end

		prevKey = pathKey
		currentValue = rawget(currentValue, PARENT_KEY) :: any
	until currentValue == nil

	if shouldReplicate and replicaterFn then
		(replicaterFn :: any)(replicateType, path, ...)
	end
end

local function ArrayInsert<T>(value: Value<any>)
	return function(item: T, pos: number?, shouldReplicate: boolean?)
		local raw = value()
		if pos then
			table.insert(raw, pos, item)
		else
			table.insert(raw, item)
		end

		adoptChildren(value)
		fireChangeAndReplicate(value, nil, "insert", shouldReplicate, item, pos)

		local insertedCbs = rawget(value, ARRAY_INSERTED_KEY)
		if insertedCbs then
			local posInsertedAt = pos or table.find(raw, item)
			for _, cb in insertedCbs do
				task.spawn(cb, item, posInsertedAt)
			end
		end
	end
end

local function ArrayRemove<T>(value: Value<any>)
	return function(pos: number?, shouldReplicate: boolean?)
		local raw = value()
		local removed = table.remove(raw, pos)
		adoptChildren(value)
		fireChangeAndReplicate(value, nil, "remove", shouldReplicate, pos)

		local removedCbs = rawget(value, ARRAY_REMOVED_KEY)
		if removedCbs then
			local posRemovedFrom = pos or #raw + 1
			for _, cb in removedCbs do
				task.spawn(cb, removed, posRemovedFrom)
			end
		end

		return removed
	end
end

local FUNCTIONAL_KEYS = {
	Changed = Changed,
	Insert = ArrayInsert,
	Remove = ArrayRemove,
	OnInsert = OnInsert,
	OnRemove = OnRemove,
	OnKeyAdded = OnKeyAdded,
	OnKeyRemoved = OnKeyRemoved,
}

meta.__index = function(value: Value<any>, index: string)
	local functionalKey = FUNCTIONAL_KEYS[index]
	if functionalKey then
		return functionalKey(value)
	end

	local raw = value()
	assert(
		type(raw) == "table",
		`attempted to index '{rawget(value, KEY_KEY)}'({typeof(raw)}) with '{index}'({typeof(index)})`
	)

	local valueChildren = rawget(value, CHILDREN_KEY) :: any
	if valueChildren and valueChildren[index] ~= nil then
		return valueChildren[index]
	end

	-- Adding new child index
	local newChild = Value.new(raw, index, value)
	if not valueChildren then
		valueChildren = {}
		rawset(value, CHILDREN_KEY, valueChildren)
	end
	valueChildren[index] = newChild

	return newChild
end

meta.__call = function(value: Value<any>, ...)
	local rawParent = rawget(value, CONTAINER_KEY) :: any
	local key = rawget(value, KEY_KEY) :: any
	local raw = if key ~= nil then rawParent[key] else rawParent -- Root has no key

	if select("#", ...) == 0 then -- someValue()
		return raw
	end

	local param, shouldReplicate = ...
	if type(param) == "function" then
		rawParent[key] = (param :: any)(raw) -- someValue(fn(prev) return prev + 1 end)
	else
		rawParent[key] = param -- someValue(1)
	end

	local updatedRaw = rawParent[key]
	adoptChildren(value)
	sendChangedSignalToChildren(value, true)
	fireChangeAndReplicate(value, raw, "set", shouldReplicate, updatedRaw)

	return updatedRaw
end

type ArrayRemove<T> = (number?, boolean?) -> T
type ArrayInsert<T> = (T, number?, boolean?) -> ()
type OnArrayRemove<T> = ((T, number?) -> ()) -> () -> ()
type OnArrayInsert<T> = ((T, number?) -> ()) -> () -> ()
type Changed<T> = ((T, T, string?) -> ()) -> () -> ()
type OnKeyAdded<T> = ((string, T) -> ()) -> () -> ()
type OnKeyRemoved<T> = ((string, T) -> ()) -> () -> ()
type ValueMeta<T> = { Changed: Changed<T> }
type ValueDictMeta<T> = { OnKeyAdded: OnKeyAdded<T>, OnKeyRemoved: OnKeyRemoved<T> }
type ValueArrayMeta<T> = {
	Remove: ArrayRemove<T>,
	Insert: ArrayInsert<T>,
	OnRemove: OnArrayRemove<T>,
	OnInsert: OnArrayInsert<T>,
}
export type ValueBase<T> = (((T | (T) -> T)?, boolean?) -> T) & ValueMeta<T>
type ValueArrayBase<T, U> = ValueBase<T> & ValueArrayMeta<U>
export type Value<T> = ValueType<T>

-- selene: allow(undefined_variable)
type function ValueType(T)
	local base = ValueBase(T)
	if not T:is("table") then
		return base
	end

	local indexer = T:indexer()
	if indexer then -- { [string]: T } or { any }
		local new = types.newtable()
		local index = indexer.index
		local result = indexer.readresult
		local valueBase = if index:is("number")
			then ValueArrayBase(T, result)
			else types.intersectionof(ValueDictMeta(result), base)

		new:setindexer(index, ValueType(result))
		return types.intersectionof(valueBase, new)
	else -- { a: x, b: y, c: z }
		local children = types.newtable()
		for key, prop in T:properties() do
			children:setproperty(key, ValueType(prop.read))
		end

		return types.intersectionof(base, children, ValueDictMeta(types.any))
	end
end

function Value.new<T>(raw: T, key: string?, parent: Value<any>?, replicator: (({ string }, any?) -> ())?): ValueType<T>
	local value = setmetatable({
		[KEY_KEY] = key,
		[PARENT_KEY] = parent,
		[CONTAINER_KEY] = raw,
		[REPLICATOR_KEY] = replicator,
		[CHILDREN_KEY] = nil,
	}, meta)

	adoptChildren(value :: any)

	return value :: any
end

return Value
]]></string>
